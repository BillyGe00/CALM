{
  "evaluation_framework": {
    "version": "1.0",
    "dimensions": [
      {
        "dimension": "constraint_satisfaction",
        "weight": 0.25,
        "description": "Does the schedule respect all hard constraints?",
        "metrics": {
          "no_time_conflicts": {
            "description": "No overlapping events",
            "scoring": "binary",
            "penalty_per_violation": 10
          },
          "mandatory_events_included": {
            "description": "All mandatory events are scheduled",
            "scoring": "percentage",
            "formula": "included_count / total_mandatory"
          },
          "sleep_minimum_met": {
            "description": "Minimum sleep hours satisfied each night",
            "threshold_from_persona": true,
            "penalty_per_violation": 15
          },
          "buffer_time_respected": {
            "description": "Adequate transition time between events",
            "minimum_buffer_minutes": 15,
            "penalty_per_violation": 5
          }
        }
      },
      {
        "dimension": "persona_alignment",
        "weight": 0.20,
        "description": "Does the schedule reflect persona-specific preferences?",
        "metrics": {
          "chronotype_match": {
            "description": "Important tasks scheduled during peak hours",
            "scoring": "percentage",
            "formula": "peak_hour_tasks / total_important_tasks"
          },
          "work_life_balance_ratios": {
            "description": "Activity distribution matches persona preferences",
            "reference": "persona.preferences.work_life_balance",
            "tolerance": 0.15
          },
          "preference_violations": {
            "description": "Count of soft constraint violations",
            "examples": ["meetings during preferred focus time", "activities during rest time"],
            "penalty_per_violation": 5
          },
          "lifestyle_compatibility": {
            "description": "Activities align with stated lifestyle",
            "examples": ["gym type", "meal timing", "social activities"],
            "scoring": "qualitative_then_binary"
          }
        }
      },
      {
        "dimension": "balance_index",
        "weight": 0.20,
        "description": "Does the schedule achieve healthy work-life balance?",
        "metrics": {
          "work_rest_personal_ratio": {
            "description": "Ratio of work:rest:personal time",
            "ideal_ratio": "10:8:6",
            "scoring": "distance_from_ideal",
            "normalization": "per_day"
          },
          "consecutive_work_hours": {
            "description": "No excessive continuous work blocks",
            "max_allowed": 4,
            "penalty_per_violation": 10
          },
          "daily_break_adequacy": {
            "description": "Sufficient breaks throughout the day",
            "minimum_breaks": 2,
            "minimum_duration_minutes": 15
          },
          "weekend_recovery": {
            "description": "Adequate downtime on weekends",
            "minimum_free_hours": 8
          }
        }
      },
      {
        "dimension": "replanning_robustness",
        "weight": 0.20,
        "description": "Under perturbations, how well does the agent adapt?",
        "metrics": {
          "post_perturbation_feasibility": {
            "description": "New schedule still satisfies all hard constraints",
            "scoring": "binary"
          },
          "edit_distance": {
            "description": "Minimal changes from original schedule",
            "calculation": "count of moved/modified/deleted events",
            "lower_is_better": true
          },
          "stability_across_trials": {
            "description": "Consistent replanning given same perturbation",
            "trials": 3,
            "metric": "variance in edit distance",
            "lower_is_better": true
          },
          "disruption_minimization": {
            "description": "Prioritizes keeping high-priority events unchanged",
            "scoring": "weighted by event priority"
          }
        }
      },
      {
        "dimension": "external_feasibility",
        "weight": 0.15,
        "description": "Are scheduled activities possible given real-world constraints?",
        "metrics": {
          "facility_hours_check": {
            "description": "Activities scheduled during operating hours",
            "data_source": "env_constraints",
            "penalty_per_violation": 20
          },
          "travel_time_realistic": {
            "description": "Sufficient time for transportation between locations",
            "calculation": "actual_travel_time vs scheduled_buffer",
            "penalty_per_violation": 10
          },
          "activity_duration_reasonable": {
            "description": "Activity duration matches typical requirements",
            "reference": "env_constraints.facilities.avg_visit_duration",
            "tolerance": 0.30
          },
          "location_accessibility": {
            "description": "Scheduled locations are reachable from prior location",
            "check": "geographic and temporal feasibility"
          }
        }
      }
    ],
    "scoring": {
      "scale": "0-100",
      "calculation": "weighted_sum of dimension scores",
      "normalization": "each dimension scored 0-100, then weighted",
      "penalty_system": "violations subtract from base score of 100 per dimension"
    },
    "reporting": {
      "per_dimension_score": true,
      "violation_details": true,
      "comparison_to_baseline": true,
      "multi_trial_statistics": {
        "mean": true,
        "std_dev": true,
        "min_max": true
      }
    }
  }
}



